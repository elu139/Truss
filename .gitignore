*.ipynb_checkpoints

# Data — large files, never commit (but keep dir structure via .gitkeep)
data/raw/*
data/processed/*
data/external/*
data/interim/*
!data/**/.gitkeep
*.parquet
*.feather
*.csv
*.tsv
*.zip
*.gz
*.tar
# (use `git add -f` for small reference files if ever needed)

# Model artifacts (root-level only — don't match src/truss/models/)
*.pkl
*.joblib
*.pt
*.pth
*.h5
*.onnx
/models/

# Logs / runs / experiment tracking
*.log
logs/
mlruns/
wandb/

